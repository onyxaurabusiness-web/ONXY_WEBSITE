{
  "version": 2,
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/assets/(.*).(jpg|png|webp|svg|mp4|glb)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/assets/(.*).(css|js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=600, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/assets/catalogue.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/aviation",
      "destination": "/partnerships#aviation",
      "permanent": true
    },
    {
      "source": "/hospitality",
      "destination": "/partnerships#hospitality",
      "permanent": true
    },
    {
      "source": "/corporate",
      "destination": "/partnerships#corporate",
      "permanent": true
    },
    {
      "source": "/private-label",
      "destination": "/partnerships#private-label",
      "permanent": true
    },
    {
      "source": "/products",
      "destination": "/collection",
      "permanent": true
    }
  ]
}
